# Copy to .env and fill in. .env is gitignored.
TYPESAFE_API_KEY=your-key-here
OPENAPI_API_KEY=your-key-here

# Classifier to use. Leave blank for dry run: matched emails are only written to the report,
# never sent to the classifier when blank.
# Supported classifiers: jev, openai, ollama
CLASSIFIER=jev

# Ollama settings, used when CLASSIFIER=ollama. MODEL is required: the model
# tag as reported by `ollama list`.
#OLLAMA_MODEL=clef-flash
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_BODY_MAX_CHARS=200000

# Optional pre-filters. An email is classified only when ALL of these pass.
# Each value is a JavaScript regex, matched case-insensitively; unset matches
# everything. FROM_FILTER tests the raw From header, DATE_FILTER the raw Date
# string, SUBJECT_FILTER the subject, and BODY_FILTER the body (also dotall, so
# `.` spans newlines). Exclusions use a negative lookahead, e.g.
#   SUBJECT_FILTER=^(?:(?!(?:passcode|verification code)).)*$
#FROM_FILTER=
#SUBJECT_FILTER=
#DATE_FILTER=
#BODY_FILTER=

# Skip emails whose parsed Date is before this timestamp. Default 1970-01-01.
#DATE_SINCE=2026-01-01

# Log to stderr why each email was skipped.
#LOG_SKIPPED=1
